# Both variables are optional. Leave them unset to run in demo mode
# (in-memory store with synthetic borrowers + rule-based document extraction).

# PostgreSQL connection string (e.g. Supabase / Neon / local Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Anthropic API key for Claude document analysis: https://console.anthropic.com/
ANTHROPIC_API_KEY="your_api_key_here"

# Optional: override the Claude model (default: claude-sonnet-5-5)
# ANTHROPIC_MODEL="claude-sonnet-5-5"
